      "html": "<div class=\"ds-key-row\"><button type=\"button\" class=\"ds-key-letter\">q</button><button type=\"button\" class=\"ds-key-letter\">w</button><button type=\"button\" class=\"ds-key-letter\">e</button><button type=\"button\" class=\"ds-key-letter\">r</button><button type=\"button\" class=\"ds-key-letter\">t</button><button type=\"button\" class=\"ds-key-letter\">y</button><button type=\"button\" class=\"ds-key-letter\">u</button><button type=\"button\" class=\"ds-key-letter\">i</button><button type=\"button\" class=\"ds-key-letter\">o</button><button type=\"button\" class=\"ds-key-letter\">p</button></div>",
      "css": ".ds-key-row{height:calc((286px - 4px - 48px) / 4);display:flex;align-items:stretch;padding:0 3px;background:#222222;}.ds-key-letter{font-family:sans-serif;font-feature-settings:\"kern\";font-size:22px;flex:1;min-width:0;align-self:stretch;margin:3.5px 2.5px;padding:0;border:0;border-radius:7px;background:#606060;color:#f4f4f4;text-align:center;}.ds-key-letter{position:relative;overflow:hidden;}.ds-key-letter::after{content:\"\";position:absolute;inset:0;border-radius:inherit;background:transparent;pointer-events:none;}.ds-key-letter:hover{background:#606060;}.ds-key-letter:focus-visible{outline:none;}.ds-key-letter:active::after,.ds-key-letter:focus-visible::after{background:#ffffff24;}"
