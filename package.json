{
  "name": "doudou-keyboard",
  "version": "0.3.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spec:build": "node spec/build.mjs",
    "spec:serve": "node demo/server.mjs",
    "demo:setup": "node demo/setup.mjs",
    "demo:build": "node android/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run spec:build && npm test",
    "android:build": "node android/build.mjs",
    "android:test": "python3 android/tools/native-host.py && cd android && ./gradlew :app:testDebugUnitTest :app:lintDebug",
    "android:sanitize": "python3 android/tools/native-host.py --sanitize"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/adb-server-node-tcp": "2.5.2",
    "@yume-chan/scrcpy-decoder-webcodecs": "2.5.3",
    "marked": "18.1.1",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
