# Copy to cloud.env outside Git, chmod 600. Generate keys once and preserve them across upgrades.
DATABASE_URL=postgresql://keyboard:REPLACE@db:5432/keyboard
MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
TOKEN_SECRET=REPLACE_WITH_RANDOM_64_CHARACTERS
ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
PUBLIC_BASE_URL=https://106.14.88.147/keyboard-api
PATH_PREFIX=/keyboard-api
TRUST_PROXY=1
BAILIAN_WORKSPACE_ID=
BAILIAN_API_KEY=
BAILIAN_TEXT_BASE_URL=
TEXT_MODEL=qwen-flash
VISION_MODEL=qwen3-vl-flash
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGNATURE=
SMS_TEMPLATE_CODE=

# Exact counter for the selected Qwen text model; never substitute a character estimate.
BAILIAN_TOKENIZER_URL=https://dashscope.aliyuncs.com/api/v1/tokenizer
MEMORY_MAX_INPUT_TOKENS=997952
MEMORY_CONTEXT_TOKENS=1000000
MEMORY_OUTPUT_TOKENS=8192
